<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ALN.Contracts\ALN.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      dev/ holds this adapter's own harness (a fake OneBot to talk to). Nested projects have to be
      excluded from the parent's default source glob, otherwise their Program.cs lands in this
      assembly and two entry points appear out of nowhere.
    -->
    <Compile Remove="dev\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
