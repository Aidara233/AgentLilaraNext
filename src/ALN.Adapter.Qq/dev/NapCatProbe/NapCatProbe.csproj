<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real adapter, not a copy of it: a probe that spoke a second dialect would prove nothing about this build. -->
    <ProjectReference Include="..\..\ALN.Adapter.Qq.csproj" />
    <!-- And the host's own file port, because "read the picture through the same door the adapter uses" is half of what
         is being checked. -->
    <ProjectReference Include="..\..\..\ALN.Runtime\ALN.Runtime.csproj" />
    <!-- The media endpoint, so the URL half is checked against a real bridge instead of a stub. -->
    <ProjectReference Include="..\..\..\ALN.Api\ALN.Api.csproj" />
  </ItemGroup>
</Project>
