<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A stand-in for NapCat / LLOneBot, used to exercise the QQ adapter without a QQ account: it accepts
    one forward WebSocket, pushes one group message, and prints whatever the adapter sends back.
    No project references on purpose — it must not be able to borrow core types and thus "help" the
    adapter in ways a real OneBot implementation would not.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
