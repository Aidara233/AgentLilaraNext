{
  "id": "model.smoke",
  "version": 1,
  "targetType": "channel",
  "mount": "default",
  "events": ["channel.message.accepted"],
  "entryPoint": "onEvent",
  "capabilities": ["model.complete", "session.run", "channel.bound-send"],
  "trustDomain": "builtin",
  "maxStatements": 10000,
  "timeoutMilliseconds": 60000,
  "memoryLimitBytes": 268435456
}
