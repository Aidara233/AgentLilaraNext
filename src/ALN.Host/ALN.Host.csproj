<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ALN.Contracts\ALN.Contracts.csproj" />
    <ProjectReference Include="..\ALN.Graph.Contracts\ALN.Graph.Contracts.csproj" />
    <ProjectReference Include="..\ALN.Runtime\ALN.Runtime.csproj" />
    <ProjectReference Include="..\ALN.Storage.Sqlite\ALN.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\ALN.Api\ALN.Api.csproj" />
    <ProjectReference Include="..\ALN.Adapter.File\ALN.Adapter.File.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ALN.Adapter.Qq\ALN.Adapter.Qq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ALN.BundledModules\ALN.BundledModules.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ALN.Model.OpenAIChat\ALN.Model.OpenAIChat.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ALN.Ssh\ALN.Ssh.csproj" />
    <ProjectReference Include="..\ALN.Net\ALN.Net.csproj" />
    <ProjectReference Include="..\ALN.Web\ALN.Web.csproj" />
    <ProjectReference Include="..\ALN.Identity\ALN.Identity.csproj" />
    <ProjectReference Include="..\ALN.Commands\ALN.Commands.csproj" />
    <ProjectReference Include="..\ALN.Coin\ALN.Coin.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="resources/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Content copying never deletes anything: a renamed or removed prompt fragment would sit in the output forever
       and keep appearing in prompts.list as a group somebody can select. The shipped prompts are a whole tree, so
       they are mirrored rather than merged. -->
  <Target Name="MirrorPromptResources" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(OutDir)resources/prompts" />
  </Target>
  <Target Name="CopyModulePackages" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)modules/adapter.file" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../ALN.Adapter.File/bin/$(Configuration)/net10.0/ALN.Adapter.File.dll;$(MSBuildProjectDirectory)/../ALN.Adapter.File/bin/$(Configuration)/net10.0/ALN.Adapter.File.deps.json;$(MSBuildProjectDirectory)/../ALN.Adapter.File/plugin.json"
          DestinationFolder="$(OutDir)modules/adapter.file" />
    <MakeDir Directories="$(OutDir)modules/adapter.qq" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../ALN.Adapter.Qq/bin/$(Configuration)/net10.0/ALN.Adapter.Qq.dll;$(MSBuildProjectDirectory)/../ALN.Adapter.Qq/bin/$(Configuration)/net10.0/ALN.Adapter.Qq.deps.json;$(MSBuildProjectDirectory)/../ALN.Adapter.Qq/plugin.json"
          DestinationFolder="$(OutDir)modules/adapter.qq" />
    <MakeDir Directories="$(OutDir)modules/bundled.runtime" />
    <ItemGroup>
      <BundledModuleFiles Include="$(MSBuildProjectDirectory)/../ALN.BundledModules/bin/$(Configuration)/net10.0/*.dll" />
      <BundledModuleFiles Include="$(MSBuildProjectDirectory)/../ALN.BundledModules/bin/$(Configuration)/net10.0/ALN.BundledModules.deps.json" />
      <BundledModuleFiles Include="$(MSBuildProjectDirectory)/../ALN.BundledModules/plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledModuleFiles)" DestinationFolder="$(OutDir)modules/bundled.runtime" />
    <MakeDir Directories="$(OutDir)modules/model.openai-chat" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../ALN.Model.OpenAIChat/bin/$(Configuration)/net10.0/ALN.Model.OpenAIChat.dll;$(MSBuildProjectDirectory)/../ALN.Model.OpenAIChat/bin/$(Configuration)/net10.0/ALN.Model.OpenAIChat.deps.json;$(MSBuildProjectDirectory)/../ALN.Model.OpenAIChat/plugin.json"
          DestinationFolder="$(OutDir)modules/model.openai-chat" />
    <MakeDir Directories="$(OutDir)modules/archive" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../ALN.Archive/bin/$(Configuration)/net10.0/ALN.Archive.dll;$(MSBuildProjectDirectory)/../ALN.Archive/bin/$(Configuration)/net10.0/ALN.Archive.deps.json;$(MSBuildProjectDirectory)/../ALN.Archive/plugin.json"
          DestinationFolder="$(OutDir)modules/archive" />
  </Target>
</Project>
