<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ALN.Contracts\ALN.Contracts.csproj" />
    <ProjectReference Include="..\ALN.Graph.Contracts\ALN.Graph.Contracts.csproj" />
    <ProjectReference Include="..\ALN.Runtime\ALN.Runtime.csproj" />
    <ProjectReference Include="..\ALN.Api\ALN.Api.csproj" />
    <ProjectReference Include="..\ALN.Adapter.File\ALN.Adapter.File.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ALN.BundledModules\ALN.BundledModules.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ALN.Model.OpenAIChat\ALN.Model.OpenAIChat.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="resources/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyModulePackages" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)modules/adapter.file" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../ALN.Adapter.File/bin/$(Configuration)/net10.0/ALN.Adapter.File.dll;$(MSBuildProjectDirectory)/../ALN.Adapter.File/bin/$(Configuration)/net10.0/ALN.Adapter.File.deps.json;$(MSBuildProjectDirectory)/../ALN.Adapter.File/module.json"
          DestinationFolder="$(OutDir)modules/adapter.file" />
    <MakeDir Directories="$(OutDir)modules/bundled.runtime" />
    <ItemGroup>
      <BundledModuleFiles Include="$(MSBuildProjectDirectory)/../ALN.BundledModules/bin/$(Configuration)/net10.0/*.dll" />
      <BundledModuleFiles Include="$(MSBuildProjectDirectory)/../ALN.BundledModules/bin/$(Configuration)/net10.0/ALN.BundledModules.deps.json" />
      <BundledModuleFiles Include="$(MSBuildProjectDirectory)/../ALN.BundledModules/module.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledModuleFiles)" DestinationFolder="$(OutDir)modules/bundled.runtime" />
    <MakeDir Directories="$(OutDir)modules/model.openai-chat" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../ALN.Model.OpenAIChat/bin/$(Configuration)/net10.0/ALN.Model.OpenAIChat.dll;$(MSBuildProjectDirectory)/../ALN.Model.OpenAIChat/bin/$(Configuration)/net10.0/ALN.Model.OpenAIChat.deps.json;$(MSBuildProjectDirectory)/../ALN.Model.OpenAIChat/module.json"
          DestinationFolder="$(OutDir)modules/model.openai-chat" />
  </Target>
</Project>
