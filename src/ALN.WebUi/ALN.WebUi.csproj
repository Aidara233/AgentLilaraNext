<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The WebUI is a separate program, and this file is where that is enforced: there is deliberately
    no ProjectReference here. The UI cannot see ALN.Contracts, let alone a manager, so every piece of
    information it shows has to come through the HTTP action surface. If a later change needs a core
    type to render a page, the fix belongs in an action's DTO, not in a reference added here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Copied so the host runs from bin/ without caring where the sources are. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
