<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ALN.Contracts\ALN.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only project that knows what SSH.NET is; everything above talks to ISshAccess. -->
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <!-- ed25519 generation and the OpenSSH key format: .NET's crypto does not do either. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
