<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The PDF fixture is built with the same library the plugin reads with: a hand-rolled PDF byte string would
         test the plugin against a file no producer would ever emit. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ALN.Contracts\ALN.Contracts.csproj" />
    <ProjectReference Include="..\..\src\ALN.Channel\ALN.Channel.csproj" />
    <ProjectReference Include="..\..\src\ALN.Runtime\ALN.Runtime.csproj" />
    <ProjectReference Include="..\..\src\ALN.Storage.Sqlite\ALN.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\ALN.Graph.Contracts\ALN.Graph.Contracts.csproj" />
    <ProjectReference Include="..\..\src\ALN.Graph\ALN.Graph.csproj" />
    <ProjectReference Include="..\..\src\ALN.Ssh\ALN.Ssh.csproj" />
    <ProjectReference Include="..\..\src\ALN.Scripting.Jint\ALN.Scripting.Jint.csproj" />
    <ProjectReference Include="..\..\src\ALN.Adapter.File\ALN.Adapter.File.csproj" />
    <ProjectReference Include="..\..\src\ALN.Adapter.Qq\ALN.Adapter.Qq.csproj" />
    <ProjectReference Include="..\..\src\ALN.Clock\ALN.Clock.csproj" />
    <ProjectReference Include="..\..\src\ALN.Api\ALN.Api.csproj" />
    <ProjectReference Include="..\..\src\ALN.Archive\ALN.Archive.csproj" />
    <ProjectReference Include="..\..\src\ALN.Model.OpenAIChat\ALN.Model.OpenAIChat.csproj" />
    <ProjectReference Include="..\..\src\ALN.Net\ALN.Net.csproj" />
    <ProjectReference Include="..\..\src\ALN.Web\ALN.Web.csproj" />
    <ProjectReference Include="..\..\src\ALN.Identity\ALN.Identity.csproj" />
    <ProjectReference Include="..\..\src\ALN.Commands\ALN.Commands.csproj" />
    <ProjectReference Include="..\..\src\ALN.Coin\ALN.Coin.csproj" />
    <ProjectReference Include="..\..\src\ALN.Rice\ALN.Rice.csproj" />
    <!-- The sample plugin is loaded by a test as a real package: the artifact that ships is the artifact tested. -->
    <ProjectReference Include="..\..\samples\plugins\sample.environment\SampleEnvironment.csproj" />
    <!-- The document plugin ships as a package too, so its tools are tested against the real byte port. -->
    <ProjectReference Include="..\..\src\plugins\aln.documents\Aln.Documents.csproj" />
  </ItemGroup>
</Project>
